# Set default behavior to auto-normalize line endings
* text=auto

# Kotlin / Java / XML source files — LF
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.proto text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.pro text eol=lf
*.kts text eol=lf

# Windows batch / shell scripts
*.bat text eol=crlf
gradlew text eol=lf

# Binary assets — no line-ending conversion
*.onnx binary
*.tflite binary
*.jar binary
*.aar binary
*.so binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.keystore binary
*.jks binary
