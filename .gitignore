# ============================================================
#  iTantra — Android Project .gitignore
# ============================================================

# ─── Gradle ─────────────────────────────────────────────────
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar
local.properties

# ─── Android Studio / IntelliJ IDEA ─────────────────────────
.idea/
*.iws
*.iml
*.ipr
captures/
.DS_Store
Thumbs.db

# ─── Generated Files ─────────────────────────────────────────
app/build/
app/src/main/assets/*.onnx
# ^ ONNX model files are large binaries generated by the
#   Python model pipeline — do not commit them to Git.
#   Run the scripts/ pipeline to regenerate them locally.

# ─── Large Binary Model Files ────────────────────────────────
models/
*.onnx
*.tflite
*.pt
*.pth
*.bin
*.ckpt
*.safetensors
*.nemo

# ─── Sherpa-ONNX AAR (downloaded at setup time) ──────────────
app/libs/*.aar
app/libs/*.jar

# ─── Native Libraries (bundled in AAR, not committed) ────────
app/src/main/jniLibs/**/*.so

# ─── Python Virtual Environment ──────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
.eggs/
.pytest_cache/
*.mypy_cache/
.ruff_cache/

# ─── Python Notebook Checkpoints ─────────────────────────────
.ipynb_checkpoints/

# ─── Logs & Diagnostic Files ─────────────────────────────────
*.log
logcat.txt
logcat_utf8.txt
crash_log.txt
crash_log_utf8.txt
download.log

# ─── Keys & Secrets ──────────────────────────────────────────
*.jks
*.keystore
keystore.properties
google-services.json
te_keys.txt
secrets.properties
*.pem
*.p12

# ─── OS Generated ────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Android Profiling & Coverage ────────────────────────────
*.hprof
*.profdata

# ─── Fonts (must be downloaded manually — see SETUP.md) ──────
app/src/main/res/font/*.ttf
app/src/main/res/font/*.otf

# ─── Scratch / Temp / Analysis Files ─────────────────────────
scratch/
*.tmp
*.bak
*.swp
codebase_analysis.md
implementation_plan.md
.artifacts/

# ─── Kotlin / JVM ────────────────────────────────────────────
.kotlin/
*.class
